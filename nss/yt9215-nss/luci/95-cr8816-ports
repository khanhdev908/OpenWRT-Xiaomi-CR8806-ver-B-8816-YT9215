#!/bin/sh
# Swap in the YT9215 Port status panel, keeping the stock one as a fallback.
# The new panel gets its own file name: browsers keep the stock 29_ports.js
# cached under the same URL (same LuCI version), so a same-name swap never
# showed up (measured).
D=/www/luci-static/resources/view/status
I=$D/include
N=/usr/share/cr8816/29_ports.js
[ -f "$N" ] || exit 0
if [ -f "$I/29_ports.js" ]; then
	cmp -s "$N" "$I/29_ports.js" || mv "$I/29_ports.js" "$D/ports_dsa.js"
	rm -f "$I/29_ports.js"
fi
cp "$N" "$I/29_ports_sw.js"
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache 2>/dev/null
exit 0
